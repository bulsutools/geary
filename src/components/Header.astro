---
import type { CategorySlug } from '../data/categories';
import SearchBar from './SearchBar';

interface Props {
  activeCategory?: CategorySlug;
  activeNav?: 'home' | 'categories';
  headerSearchShortcut?: boolean;
}

const { activeCategory, activeNav, headerSearchShortcut = true } = Astro.props;
const currentSection = activeNav ?? (activeCategory ? 'categories' : undefined);

const NAV_LINKS = [
  { label: 'Home', href: '/', key: 'home' as const },
  { label: 'Categories', href: '/categories', key: 'categories' as const },
];
---

<header class="sticky top-0 z-40 border-b border-[#DEE2E6] bg-[#F8F9FA]/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6 lg:gap-8">
      <a
        href="/"
        class="inline-flex shrink-0 items-center gap-2.5 rounded-lg py-1 pr-1 text-[#181C20] hover:text-[#8B1538] transition-colors duration-150"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 32 32"
          fill="none"
          class="h-7 w-7 shrink-0"
        >
          <g fill="#8B1538">
            <rect x="13" y="2" width="6" height="28" rx="1.5" />
            <rect x="13" y="2" width="6" height="28" rx="1.5" transform="rotate(45 16 16)" />
            <rect x="13" y="2" width="6" height="28" rx="1.5" transform="rotate(90 16 16)" />
            <rect x="13" y="2" width="6" height="28" rx="1.5" transform="rotate(135 16 16)" />
            <circle cx="16" cy="16" r="10.5" />
          </g>
          <circle cx="16" cy="16" r="6.5" fill="#D4A017" />
          <circle cx="16" cy="16" r="3.4" fill="#F8F9FA" />
        </svg>
        <span class="font-[family-name:var(--font-heading)] text-lg font-extrabold tracking-tight">
          Geary
        </span>
      </a>

      <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-1 lg:gap-2">
        {
          NAV_LINKS.map((item) => {
            const isActive = currentSection === item.key;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={`rounded-lg px-3 py-1.5 text-sm whitespace-nowrap transition-colors duration-150 ${
                  isActive
                    ? 'bg-[#FDF2F4] font-semibold text-[#8B1538]'
                    : 'font-medium text-[#495057] hover:bg-[#EEF1F4] hover:text-[#8B1538]'
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>

    <div class="flex flex-1 md:flex-initial items-center justify-end gap-2 min-w-0">
      <div class="w-full max-w-[200px] sm:max-w-[220px] md:w-48 lg:w-60">
        <SearchBar
          client:load
          variant="header"
          enableGlobalShortcut={headerSearchShortcut}
        />
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle site navigation"
        class="inline-flex md:hidden min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-lg border border-[#DEE2E6] bg-white text-[#181C20] hover:border-[#8B1538] hover:text-[#8B1538] transition-colors duration-150"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav-drawer"
    aria-label="Mobile navigation"
    class="hidden md:hidden border-t border-[#DEE2E6] bg-white px-4 py-3"
  >
    <ul class="space-y-1">
      {
        NAV_LINKS.map((item) => {
          const isActive = currentSection === item.key;
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={`flex min-h-[44px] items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-150 ${
                  isActive
                    ? 'bg-[#FDF2F4] font-semibold text-[#8B1538]'
                    : 'text-[#181C20] hover:bg-[#F8F9FA] hover:text-[#8B1538]'
                }`}
              >
                <span>{item.label}</span>
                <span aria-hidden="true" class="text-[#636C74]">→</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      drawer.classList.toggle('hidden', expanded);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
      }
    });
  })();
</script>
