---
import { getArticleSlug, type ArticleLike } from '../lib/articles';

interface Props {
  article: ArticleLike;
}

const { article } = Astro.props;
const slug = getArticleSlug(article);
---

<a
  href={`/articles/${slug}`}
  class="group flex flex-col justify-between rounded-xl border border-[#DEE2E6] bg-white p-5 transition-colors duration-150 hover:border-[#8B1538]"
>
  <h3 class="font-[family-name:var(--font-heading)] text-base font-semibold leading-snug text-[#181C20] group-hover:text-[#8B1538] transition-colors duration-150">
    {article.data.title}
  </h3>

  <div class="mt-1.5 flex items-end justify-between gap-3">
    <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-[#495057]">
      {article.data.description}
    </p>
    <span
      aria-hidden="true"
      class="shrink-0 text-base font-semibold leading-none text-[#8B1538] group-hover:translate-x-0.5 group-hover:text-[#6E0F2B] transition-all duration-150"
    >
      →
    </span>
  </div>
</a>
