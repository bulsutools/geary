---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AskPanel from '../components/AskPanel';
---

<BaseLayout
  title="Ask the Handbook - Geary"
  description="Ask Geary a question in plain language and get a cited answer drawn from published BulSU student articles."
  activeNav="ask"
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mb-8 border-b border-border-subtle pb-6 max-w-[65ch]">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Ask the Handbook' },
        ]}
      />

      <h1 class="font-heading text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] tracking-[-0.02em] text-ink-primary">
        Ask the Handbook
      </h1>

      <p class="mt-3 text-base sm:text-lg leading-relaxed text-ink-secondary">
        Ask a question in plain language. Answers are built only from published
        Geary articles and link back to their sources.
      </p>
    </div>

    <AskPanel client:load />

    <div class="mx-auto mt-10 max-w-prose space-y-3 text-sm leading-relaxed text-ink-secondary">
      <p>
        <span class="font-semibold text-ink-primary">How it works.</span>{' '}
        Your question is matched against the handbook locally in your browser,
        then sent once to Geary&apos;s answer service together with the matched
        article passages. Nothing is stored.
      </p>
      <p>
        <span class="font-semibold text-ink-primary">Freshness.</span>{' '}
        Every answer lists its sources with the date each article was last
        updated. For fees, deadlines, and schedules, confirm details with the
        official BulSU office before acting.
      </p>
      <p>
        Looking for something specific?{' '}
        <a
          href="/articles"
          class="font-medium text-brand-crimson hover:text-brand-crimson-hover hover:underline underline-offset-2 transition-colors"
        >
          Browse all articles
        </a>{' '}
        or use the{' '}
        <a
          href="/"
          class="font-medium text-brand-crimson hover:text-brand-crimson-hover hover:underline underline-offset-2 transition-colors"
        >
          search bar
        </a>
        .
      </p>
    </div>
  </div>
</BaseLayout>
