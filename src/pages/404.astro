---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';
import { CATEGORIES } from '../data/categories';
---

<BaseLayout
  title="Page Not Found - Geary"
  description="The BulSU student guide you requested could not be found. Search or browse categories to get back on track."
  headerSearchShortcut={false}
>
  <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6 sm:py-20 text-center">
    <span class="inline-flex items-center rounded-full bg-[#FDF2F4] px-3 py-1 text-xs font-semibold text-[#8B1538]">
      404 — Page Not Found
    </span>

    <h1 class="mt-4 font-[family-name:var(--font-heading)] text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] text-[#181C20]">
      We couldn&apos;t find that guide.
    </h1>

    <p class="mt-3 text-base text-[#495057]">
      The link may have moved or been mistyped. Search for what you need below or jump straight to a student category.
    </p>

    <div class="mt-7">
      <SearchBar
        client:load
        variant="hero"
        enableGlobalShortcut={true}
      />
    </div>

    <div class="mt-8 rounded-xl border border-[#DEE2E6] bg-white p-5 sm:p-6 text-left">
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-[#495057]">
        Browse Student Categories
      </h2>
      <div class="flex flex-wrap gap-2">
        {
          CATEGORIES.map((category) => (
            <a
              href={`/categories/${category.slug}`}
              class="inline-flex min-h-[40px] items-center rounded-full border border-[#DEE2E6] bg-[#F8F9FA] px-3.5 py-1.5 text-sm font-medium text-[#181C20] hover:border-[#8B1538] hover:text-[#8B1538] transition-colors"
            >
              {category.title}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-8">
      <a
        href="/"
        class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-[#8B1538] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#6E0F2B] transition-colors"
      >
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
