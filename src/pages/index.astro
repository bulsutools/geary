---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';
import ExploreSpotlight, { type ExploreItem } from '../components/ExploreSpotlight';
import {
  formatArticleDate,
  formatLocalDateKey,
  getArticlePreview,
  getArticleSlug,
  getRecentlyUpdatedArticles,
} from '../lib/articles';
import { buildWebsiteJsonLd } from '../lib/seo';

const allArticles = await getCollection('articles');
const recentlyUpdatedArticles = getRecentlyUpdatedArticles(allArticles, 6);

const featuredPool: ExploreItem[] = [...allArticles]
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => ({
    slug: getArticleSlug(entry),
    title: entry.data.title,
    preview: getArticlePreview(entry),
  }));

const initialDateKey = formatLocalDateKey(new Date());
const baseOrigin = Astro.site ?? new URL(Astro.url.origin);
const websiteJsonLd = buildWebsiteJsonLd(baseOrigin.href);
---

<BaseLayout
  title="Geary"
  description="Student-managed guides for BulSUans, by BulSUans."
  activeNav="home"
  headerSearchShortcut={false}
  jsonLd={websiteJsonLd}
>
  <section class="relative z-20 border-b border-border-subtle bg-canvas-paper py-12 sm:py-14 lg:py-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <svg
        viewBox="0 0 200 200"
        fill="none"
        class="absolute -right-12 -top-12 h-64 w-64 text-brand-crimson/5 sm:h-80 sm:w-80 motion-safe:animate-[spin_30s_linear_infinite]"
      >
        <g fill="currentColor">
          <rect x="82" y="10" width="36" height="180" rx="8" />
          <rect x="82" y="10" width="36" height="180" rx="8" transform="rotate(45 100 100)" />
          <rect x="82" y="10" width="36" height="180" rx="8" transform="rotate(90 100 100)" />
          <rect x="82" y="10" width="36" height="180" rx="8" transform="rotate(135 100 100)" />
          <circle cx="100" cy="100" r="64" />
        </g>
        <circle cx="100" cy="100" r="38" fill="#F8F9FA" />
      </svg>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="font-heading text-[1.875rem] sm:text-[2.5rem] font-extrabold leading-[1.15] tracking-[-0.025em] text-ink-primary">
          The Better BulSU Student Handbook
        </h1>

        <p class="mt-4 text-base sm:text-lg leading-relaxed text-ink-secondary">
          Student-managed guides for BulSUans, by BulSUans.
        </p>

        <div class="mt-7">
          <SearchBar
            client:load
            variant="hero"
            enableGlobalShortcut={true}
          />
        </div>
      </div>
    </div>
  </section>

  <ExploreSpotlight
    client:load
    items={featuredPool}
    initialDateKey={initialDateKey}
    count={3}
  />

  {
    recentlyUpdatedArticles.length > 0 && (
      <section aria-labelledby="recently-updated-heading" class="border-t border-border-subtle py-10 sm:py-12">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="mb-6">
            <h2
              id="recently-updated-heading"
              class="font-heading text-xl sm:text-2xl font-bold text-ink-primary"
            >
              Recently Updated
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-6">
            {recentlyUpdatedArticles.map((article) => {
              const slug = getArticleSlug(article);
              const preview = getArticlePreview(article);

              return (
                <a
                  href={`/articles/${slug}`}
                  class="group flex flex-col justify-between rounded-xl border border-border-subtle bg-white p-5 transition-colors duration-150 hover:border-brand-crimson"
                >
                  <div>
                    <time
                      datetime={article.data.updatedDate.toISOString().slice(0, 10)}
                      class="mb-1.5 block text-xs font-medium text-ink-muted"
                    >
                      {formatArticleDate(article.data.updatedDate)}
                    </time>

                    <h3 class="font-heading text-base font-semibold leading-snug text-ink-primary transition-colors duration-150 group-hover:text-brand-crimson">
                      {article.data.title}
                    </h3>
                  </div>

                  <div class="mt-1.5 flex items-end justify-between gap-3">
                    <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-ink-secondary">
                      {preview}
                    </p>
                    <span
                      aria-hidden="true"
                      class="shrink-0 text-base font-semibold leading-none text-brand-crimson transition-all duration-150 group-hover:translate-x-0.5 group-hover:text-brand-crimson-hover"
                    >
                      →
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
